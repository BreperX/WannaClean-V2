/////////////////////////////////////////////////////////////////////////////
//
// Icono
//

// El icono principal también se usa en la barra de título.

IDI_APP       ICON         "..\\Assets\\WannaClean.ico"
IDI_SMALL     ICON         "..\\Assets\\WannaClean.ico"
IDR_ICON_FONT RCDATA "Assets/Font Awesome 6 Free-Solid-900.otf"

/////////////////////////////////////////////////////////////////////////////
//
// Menú
//

IDC_APP MENU
BEGIN
    POPUP "&Archivo"
    BEGIN
        MENUITEM "&Salir",                IDM_EXIT
    END
    POPUP "Ay&uda"
    BEGIN
        MENUITEM "&Acerca de...",           IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Acelerador
//

IDC_APP ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// Cuadro de diálogo
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Acerca de App"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            IDI_APP,IDC_STATIC,14,14,21,20
    LTEXT           "App, Versión 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (c) 2026",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "Aceptar",IDOK,113,41,50,14,WS_GROUP
END

